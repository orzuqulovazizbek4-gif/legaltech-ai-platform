# Ushbu fayldan nusxa olib, nomini ".env" ga o‘zgartiring va kalitingizni yozing.
# Bepul kalit: https://aistudio.google.com/apikey
GEMINI_API_KEY=bu_yerga_gemini_api_kalitingizni_yozing

# Ixtiyoriy: model nomi (standart qiymat: gemini-2.5-flash).
# Agar bu model Google tomonidan o‘chirilgan bo‘lsa, ilova avtomatik ravishda zaxira modelga o‘tadi.
# GEMINI_MODEL=gemini-2.5-flash

# Ixtiyoriy: bitta tashrif (sessiya) uchun AI so‘rovlari chegarasi (standart: 30).
# AI_SESSION_LIMIT=30
